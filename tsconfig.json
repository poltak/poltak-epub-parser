{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["src", "epub-parser.test.ts", "test-utils"]
}
